<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootStack" prefHeight="720.0" prefWidth="1280.0" stylesheets="@../css/dashboard.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AdminDashboardController">

    <ScrollPane fx:id="mainContentScroll" fitToWidth="true" styleClass="main-scroll">
        <VBox fx:id="dashboardContent" spacing="28.0" styleClass="dashboard-container">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="top-nav">
                <Button onAction="#toggleSidebar" prefWidth="95.0" styleClass="hamburger-btn" text="Menu" />
                <Label fx:id="adminNameLabel" styleClass="user-name" text="Welcome, Admin" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="brandTitleLabel" styleClass="brand-text" text="CSMS ADMIN PORTAL" />
                <Button fx:id="schoolProfileButton" styleClass="avatar-button" text="S" />
            </HBox>

            <HBox alignment="CENTER_LEFT" styleClass="admin-welcome-bar">
                <Label styleClass="admin-welcome-text" text="Welcome to your Admin Dashboard" />
            </HBox>

            <TilePane hgap="28.0" prefColumns="4" prefTileHeight="132.0" prefTileWidth="236.0" styleClass="admin-stat-grid" vgap="20.0">
                <VBox styleClass="admin-stat-card">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="admin-card-icon" text="S" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="admin-card-title" text="Students" />
                    </HBox>
                    <Label fx:id="studentsCountLabel" styleClass="admin-card-count" text="0" />
                    <Separator />
                </VBox>

                <VBox styleClass="admin-stat-card">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="admin-card-icon" text="T" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="admin-card-title" text="Teachers" />
                    </HBox>
                    <Label fx:id="teachersCountLabel" styleClass="admin-card-count" text="0" />
                    <Separator />
                </VBox>

                <VBox styleClass="admin-stat-card">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="admin-card-icon" text="C" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="admin-card-title" text="Counsellors" />
                    </HBox>
                    <Label fx:id="counsellorsCountLabel" styleClass="admin-card-count" text="0" />
                    <Separator />
                </VBox>

                <VBox styleClass="admin-stat-card">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="admin-card-icon" text="CL" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="admin-card-title" text="Classes" />
                    </HBox>
                    <Label fx:id="classesCountLabel" styleClass="admin-card-count" text="0" />
                    <Separator />
                </VBox>

                <VBox styleClass="admin-stat-card">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="admin-card-icon" text="L" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="admin-card-title" text="Active Sessions" />
                    </HBox>
                    <Label fx:id="activeSessionsLabel" styleClass="admin-card-count" text="0" />
                    <Separator />
                </VBox>

                <VBox styleClass="admin-stat-card">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="admin-card-icon" text="R" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="admin-card-title" text="Red Flags" />
                    </HBox>
                    <Label fx:id="redFlagsLabel" styleClass="admin-card-count" text="0" />
                    <Separator />
                </VBox>
            </TilePane>
        </VBox>
    </ScrollPane>

    <Pane fx:id="overlayPane" onMouseClicked="#toggleSidebar" styleClass="overlay-dim" visible="false" />

    <VBox fx:id="sidebar" maxWidth="300.0" prefWidth="300.0" styleClass="sidebar" translateX="-300.0" StackPane.alignment="CENTER_LEFT">
        <Label styleClass="sidebar-header" text="ADMIN MENU" />
        <Separator opacity="0.2" />

        <Button onAction="#scrollToTop" styleClass="side-btn" text="Dashboard" />
        <Button onAction="#openUserManagement" styleClass="side-btn" text="User Management" />
        <Button onAction="#openAcademicMapping" styleClass="side-btn" text="Academic Setup" />
        <Button onAction="#openSystemLogs" styleClass="side-btn" text="System Logs" />
        <Button onAction="#openSettings" styleClass="side-btn" text="Settings" />

        <Region VBox.vgrow="ALWAYS" />
        <Button maxWidth="Infinity" onAction="#handleLogout" styleClass="logout-btn" text="Logout" />
    </VBox>
</StackPane>
