<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="subview-root" stylesheets="@../css/dashboard.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AdminLogsController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="chart-container">
        <Button onAction="#backToDashboard" styleClass="hamburger-btn" text="Back to Dashboard" />
        <Separator orientation="VERTICAL" />
        <Label styleClass="section-header" text="System Logs" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleRefresh" styleClass="hamburger-btn" text="Refresh" />
        <Label fx:id="adminContextLabel" text="Admin: -" />
    </HBox>

    <VBox spacing="14.0" styleClass="chart-container" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label styleClass="section-header" text="Login Audit" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleDeleteSelected" styleClass="hamburger-btn" text="Delete Selected" />
            <Button onAction="#handleClearAll" styleClass="logout-btn" text="Clear All" />
        </HBox>
        <TableView fx:id="auditTable" prefHeight="560.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="profilePicCol" prefWidth="72.0" text="Pic" />
                <TableColumn fx:id="logIdCol" prefWidth="80.0" text="Log ID" />
                <TableColumn fx:id="userCol" prefWidth="220.0" text="User" />
                <TableColumn fx:id="roleCol" prefWidth="130.0" text="Role" />
                <TableColumn fx:id="loginCol" prefWidth="190.0" text="Login Time" />
                <TableColumn fx:id="logoutCol" prefWidth="190.0" text="Logout Time" />
                <TableColumn fx:id="ipCol" prefWidth="150.0" text="IP Address" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <Label fx:id="statusLabel" styleClass="error-text" text="" wrapText="true" />
    </VBox>
</VBox>
