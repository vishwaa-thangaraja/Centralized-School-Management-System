<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" style="-fx-background-color: #f4f7f9;" stylesheets="@../css/dashboard.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CounsellorRequestsController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="chart-container">
        <Button onAction="#backToDashboard" styleClass="hamburger-btn" text="Back to Dashboard" />
        <Separator orientation="VERTICAL" />
        <Label styleClass="section-header" text="Counselling Requests" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="counsellorContextLabel" text="Counsellor: -" />
    </HBox>

    <VBox spacing="14.0" styleClass="chart-container" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Label styleClass="section-header" text="Requests &amp; Cases" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="acceptButton" onAction="#handleAcceptRequest" styleClass="login-button" text="Accept Request" />
            <Button fx:id="completeButton" onAction="#handleCompleteRequest" styleClass="hamburger-btn" text="Mark Completed" />
            <Button onAction="#handleRefresh" styleClass="hamburger-btn" text="Refresh" />
        </HBox>

        <TableView fx:id="requestsTable" prefHeight="560.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="sessionIdCol" prefWidth="80.0" text="ID" />
                <TableColumn fx:id="studentNameCol" prefWidth="160.0" text="Student" />
                <TableColumn fx:id="classCol" prefWidth="140.0" text="Class" />
                <TableColumn fx:id="dateCol" prefWidth="120.0" text="Preferred Date" />
                <TableColumn fx:id="categoryCol" prefWidth="120.0" text="Category" />
                <TableColumn fx:id="statusCol" prefWidth="120.0" text="Status" />
                <TableColumn fx:id="notesCol" prefWidth="420.0" text="Concern / Notes" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <Label fx:id="statusLabel" styleClass="error-text" text="" wrapText="true" />
    </VBox>
</VBox>
