<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox prefHeight="720.0" prefWidth="1280.0" styleClass="login-root" stylesheets="@../css/login.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ForgotPasswordController">
    <VBox fx:id="imagePanel" prefWidth="640.0" styleClass="image-section" HBox.hgrow="ALWAYS" />
    <VBox alignment="CENTER" prefWidth="640.0" spacing="20.0" styleClass="login-section" HBox.hgrow="ALWAYS">
        <padding><Insets left="100.0" right="100.0" /></padding>
        <Label styleClass="header-text" text="Forgot Password" />
        <TextField fx:id="emailField" promptText="Enter Registered Email" styleClass="input-field" />
        <Button fx:id="sendOtpBtn" maxWidth="Infinity" onAction="#handleSendOTP" styleClass="login-button" text="Send OTP" />
        <TextField fx:id="otpField" promptText="Enter 6-Digit OTP" styleClass="input-field" visible="false" />
        <PasswordField fx:id="newPasswordField" promptText="New Password" styleClass="input-field" visible="false" />
        <Button fx:id="resetBtn" maxWidth="Infinity" onAction="#handleResetPassword" styleClass="login-button" text="Reset Password" visible="false" />
        <Label fx:id="statusLabel" styleClass="error-text" />
        <Hyperlink onAction="#backToLogin" text="Back to Login" />
    </VBox>
</HBox>
