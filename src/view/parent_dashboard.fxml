<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>

<StackPane fx:id="rootStack" prefHeight="720.0" prefWidth="1280.0" stylesheets="@../css/dashboard.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ParentDashboardController">

    <ScrollPane fx:id="mainContentScroll" fitToWidth="true" styleClass="main-scroll">
        <VBox fx:id="dashboardContent" spacing="24.0" styleClass="dashboard-container">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="top-nav">
                <Button onAction="#toggleSidebar" prefWidth="95.0" styleClass="hamburger-btn" text="Menu" />
                <Label fx:id="brandTitleLabel" styleClass="brand-text" text="CSMS PARENT PORTAL" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="parentNameLabel" styleClass="user-name" text="Welcome, Parent" />
                <Button onAction="#handleLogout" styleClass="logout-btn" text="Logout" />
            </HBox>

            <VBox styleClass="profile-card">
                <Label styleClass="section-header" text="Ward Profile" />
                <GridPane hgap="18.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="130.0" prefWidth="170.0" />
                        <ColumnConstraints minWidth="10.0" prefWidth="14.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>

                    <Label styleClass="profile-label" text="Name" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Label styleClass="profile-separator" text=":" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    <Label fx:id="wardNameLabel" styleClass="profile-value" text="-" GridPane.columnIndex="2" GridPane.rowIndex="0" />

                    <Label styleClass="profile-label" text="Class" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <Label styleClass="profile-separator" text=":" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    <Label fx:id="wardClassLabel" styleClass="profile-value" text="-" GridPane.columnIndex="2" GridPane.rowIndex="1" />

                    <Label styleClass="profile-label" text="Email" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <Label styleClass="profile-separator" text=":" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    <Label fx:id="wardEmailLabel" styleClass="profile-value" text="-" GridPane.columnIndex="2" GridPane.rowIndex="2" />

                    <Label styleClass="profile-label" text="Gender" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <Label styleClass="profile-separator" text=":" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                    <Label fx:id="wardGenderLabel" styleClass="profile-value" text="-" GridPane.columnIndex="2" GridPane.rowIndex="3" />

                    <Label styleClass="profile-label" text="Date of Birth" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                    <Label styleClass="profile-separator" text=":" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                    <Label fx:id="wardDobLabel" styleClass="profile-value" text="-" GridPane.columnIndex="2" GridPane.rowIndex="4" />

                    <Label styleClass="profile-label" text="Conduct Status" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                    <Label styleClass="profile-separator" text=":" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                    <Label fx:id="wardConductLabel" styleClass="profile-value" text="-" GridPane.columnIndex="2" GridPane.rowIndex="5" />
                </GridPane>
            </VBox>

            <HBox spacing="20.0">
                <VBox styleClass="stat-box" spacing="12.0" prefWidth="360.0">
                    <Label styleClass="section-header" text="Today's Attendance" />
                    <HBox spacing="20.0">
                        <VBox spacing="6.0">
                            <Label text="FN" />
                            <Label fx:id="todayFnLabel" styleClass="profile-value" text="Not Marked" />
                        </VBox>
                        <VBox spacing="6.0">
                            <Label text="AN" />
                            <Label fx:id="todayAnLabel" styleClass="profile-value" text="Not Marked" />
                        </VBox>
                    </HBox>
                </VBox>

                <VBox styleClass="stat-box" spacing="10.0" prefWidth="360.0">
                    <Label styleClass="section-header" text="Overall Attendance" />
                    <Label text="Total Sessions" />
                    <Label fx:id="overallSessionsLabel" styleClass="profile-value" text="0" />
                    <Label text="Present Sessions" />
                    <Label fx:id="overallPresentLabel" styleClass="profile-value" text="0" />
                    <Label text="Attendance %" />
                    <Label fx:id="overallPercentLabel" styleClass="profile-value" text="0.00%" />
                </VBox>

                <VBox styleClass="stat-box" spacing="10.0" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label styleClass="section-header" text="Red Flag Alerts (&lt;50%)" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="Total:" />
                        <Label fx:id="alertCountLabel" text="0" />
                    </HBox>
                    <Button fx:id="downloadPerformancePdfButton" onAction="#handleDownloadPerformancePdf" styleClass="hamburger-btn" text="Download Performance PDF" />
                </VBox>
            </HBox>

            <VBox styleClass="chart-container" spacing="12.0" VBox.vgrow="ALWAYS">
                <Label styleClass="section-header" text="Attendance Tracker" />
                <TableView fx:id="attendanceHistoryTable" prefHeight="280.0">
                    <columns>
                        <TableColumn fx:id="attendanceDateCol" prefWidth="170.0" text="Date" />
                        <TableColumn fx:id="attendanceFnCol" prefWidth="150.0" text="FN" />
                        <TableColumn fx:id="attendanceAnCol" prefWidth="150.0" text="AN" />
                        <TableColumn fx:id="attendanceRemarkCol" prefWidth="220.0" text="Remarks" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <VBox styleClass="chart-container" spacing="12.0" VBox.vgrow="ALWAYS">
                <Label styleClass="section-header" text="Performance Alerts" />
                <TableView fx:id="alertsTable" prefHeight="280.0">
                    <columns>
                        <TableColumn fx:id="alertSubjectCol" prefWidth="220.0" text="Subject" />
                        <TableColumn fx:id="alertExamCol" prefWidth="210.0" text="Exam" />
                        <TableColumn fx:id="alertDateCol" prefWidth="120.0" text="Date" />
                        <TableColumn fx:id="alertMarksCol" prefWidth="170.0" text="Marks" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <Label fx:id="homeStatusLabel" styleClass="error-text" text="Select a ward to view details." wrapText="true" />
        </VBox>
    </ScrollPane>

    <Pane fx:id="overlayPane" onMouseClicked="#toggleSidebar" styleClass="overlay-dim" visible="false" />

    <VBox fx:id="sidebar" maxWidth="300.0" prefWidth="300.0" styleClass="sidebar" translateX="-300.0" StackPane.alignment="CENTER_LEFT">
        <Label styleClass="sidebar-header" text="PARENT MENU" />
        <Separator opacity="0.2" />

        <Label styleClass="sidebar-header" text="Select Ward" />
        <ComboBox fx:id="wardSelector" maxWidth="Infinity" />

        <Button onAction="#scrollToTop" styleClass="side-btn" text="Dashboard Home" />
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Button fx:id="teacherConnectButton" onAction="#openTeacherConnect" styleClass="side-btn" text="Teacher Connect" />
            <Label fx:id="teacherConnectBadgeLabel" styleClass="sidebar-badge" text="0" visible="false" managed="false" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Button fx:id="counsellorConnectButton" onAction="#openCounsellorConnect" styleClass="side-btn" text="Counsellor Connect" />
            <Label fx:id="counsellorConnectBadgeLabel" styleClass="sidebar-badge" text="0" visible="false" managed="false" />
        </HBox>
        <Button onAction="#openCounsellingRequest" styleClass="side-btn" text="Request Counselling" />
    </VBox>
</StackPane>
