<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="subview-root" stylesheets="@../css/dashboard.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.StudentAssignmentsController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="chart-container">
        <Button onAction="#backToDashboard" styleClass="hamburger-btn" text="Back to Dashboard" />
        <Separator orientation="VERTICAL" />
        <Label styleClass="section-header" text="Assignments" />
        <Region HBox.hgrow="ALWAYS" />
        <VBox alignment="CENTER_RIGHT">
            <Label text="Pending" />
            <Label fx:id="pendingCountLabel" text="0" />
        </VBox>
        <VBox alignment="CENTER_RIGHT">
            <Label text="Completed" />
            <Label fx:id="completedCountLabel" text="0" />
        </VBox>
    </HBox>

    <HBox spacing="24.0" VBox.vgrow="ALWAYS">
        <VBox spacing="12.0" prefWidth="860.0" styleClass="stat-box">
            <Label styleClass="section-header" text="Pending Assignment List" />
            <TableView fx:id="assignmentsTable" prefHeight="560.0" prefWidth="820.0">
                <columns>
                    <TableColumn fx:id="titleCol" prefWidth="360.0" text="Title" />
                    <TableColumn fx:id="subjectCol" prefWidth="210.0" text="Subject" />
                    <TableColumn fx:id="dueDateCol" prefWidth="140.0" text="Due Date" />
                    <TableColumn fx:id="statusCol" prefWidth="130.0" text="Status" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

        <VBox spacing="16.0" HBox.hgrow="ALWAYS" styleClass="stat-box">
            <Label styleClass="section-header" text="Assignment Details" />

            <GridPane hgap="14.0" vgap="12.0">
                <Label text="Title" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Label fx:id="assignmentTitleLabel" text="No assignment selected" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Subject" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Label fx:id="subjectLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Class" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <Label fx:id="classLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Due Date" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <Label fx:id="dueDateLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Submission Status" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <Label fx:id="submissionStatusLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                <Label text="Description" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                <Label fx:id="descriptionLabel" wrapText="true" text="-" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            </GridPane>

            <HBox spacing="12.0">
                <Button fx:id="viewAssignmentButton" onAction="#handleViewAssignmentPdf" styleClass="hamburger-btn" text="View Assignment PDF" />
                <Button fx:id="uploadSolutionButton" onAction="#handleUploadSolutionPdf" styleClass="login-button" text="Upload Solution PDF" />
                <Button fx:id="viewSubmissionButton" onAction="#handleViewSubmissionPdf" styleClass="hamburger-btn" text="View My Upload" />
                <Button onAction="#handleRefresh" styleClass="hamburger-btn" text="Refresh" />
            </HBox>

            <Label fx:id="statusLabel" styleClass="error-text" wrapText="true" text="" />
        </VBox>
    </HBox>
</VBox>
