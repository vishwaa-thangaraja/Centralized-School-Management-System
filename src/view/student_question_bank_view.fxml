<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="subview-root" stylesheets="@../css/dashboard.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.StudentQuestionBankController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="chart-container">
        <Button onAction="#backToDashboard" styleClass="hamburger-btn" text="Back to Dashboard" />
        <Separator orientation="VERTICAL" />
        <Label styleClass="section-header" text="Question Bank" />
        <Region HBox.hgrow="ALWAYS" />
        <VBox alignment="CENTER_RIGHT">
            <Label text="Available Papers" />
            <Label fx:id="totalQuestionsLabel" text="0" />
        </VBox>
        <Button onAction="#handleRefresh" styleClass="hamburger-btn" text="Refresh" />
    </HBox>

    <HBox spacing="24.0" VBox.vgrow="ALWAYS">
        <VBox spacing="12.0" prefWidth="880.0" styleClass="stat-box">
            <Label styleClass="section-header" text="Available Question Papers" />
            <TableView fx:id="questionTable" prefHeight="620.0">
                <columns>
                    <TableColumn fx:id="titleCol" prefWidth="320.0" text="Title" />
                    <TableColumn fx:id="subjectCol" prefWidth="200.0" text="Subject" />
                    <TableColumn fx:id="yearCol" prefWidth="120.0" text="Year" />
                    <TableColumn fx:id="teacherCol" prefWidth="180.0" text="Teacher" />
                    <TableColumn fx:id="uploadedCol" prefWidth="160.0" text="Uploaded" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

        <VBox spacing="16.0" HBox.hgrow="ALWAYS" styleClass="stat-box">
            <Label styleClass="section-header" text="Selected Paper" />
            <GridPane hgap="14.0" vgap="12.0">
                <Label text="Title" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Label fx:id="selectedTitleLabel" text="No question paper selected" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Subject" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Label fx:id="selectedSubjectLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Teacher" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <Label fx:id="selectedTeacherLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </GridPane>

            <HBox spacing="12.0">
                <Button fx:id="openButton" onAction="#handleOpenPdf" styleClass="login-button" text="Open PDF" />
                <Button fx:id="downloadButton" onAction="#handleDownloadPdf" styleClass="hamburger-btn" text="Download PDF" />
            </HBox>

            <Label fx:id="statusLabel" styleClass="error-text" wrapText="true" text="" />
        </VBox>
    </HBox>
</VBox>
