<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="subview-root" stylesheets="@../css/dashboard.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.TeacherAssignmentsController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="chart-container">
        <Button onAction="#backToDashboard" styleClass="hamburger-btn" text="Back to Dashboard" />
        <Separator orientation="VERTICAL" />
        <VBox spacing="6.0">
            <Label styleClass="section-header" text="Assignments" />
            <Label fx:id="teacherInfoLabel" wrapText="true" text="Teacher: -" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <VBox alignment="CENTER_RIGHT">
            <Label text="Published Assignments" />
            <Label fx:id="assignmentCountLabel" text="0" />
        </VBox>
    </HBox>

    <HBox spacing="24.0">
        <VBox spacing="12.0" prefWidth="900.0" styleClass="stat-box">
            <Label styleClass="section-header" text="Assignments Waiting for Submission" />
            <TableView fx:id="assignmentsTable" prefHeight="360.0" prefWidth="860.0">
                <columns>
                    <TableColumn fx:id="titleCol" prefWidth="340.0" text="Title" />
                    <TableColumn fx:id="classCol" prefWidth="240.0" text="Class" />
                    <TableColumn fx:id="dueDateCol" prefWidth="140.0" text="Due Date" />
                    <TableColumn fx:id="submittedCol" prefWidth="90.0" text="Done" />
                    <TableColumn fx:id="pendingCol" prefWidth="90.0" text="Pending" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

        <VBox spacing="16.0" HBox.hgrow="ALWAYS" styleClass="stat-box">
            <Label styleClass="section-header" text="Publish Assignment PDF" />

            <GridPane hgap="14.0" vgap="12.0">
                <Label text="Class" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <ComboBox fx:id="classCombo" prefWidth="260.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Subject" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <ComboBox fx:id="subjectCombo" prefWidth="260.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Title" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="titleField" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Due Date" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextField fx:id="dueDateField" promptText="YYYY-MM-DD" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Description" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <TextArea fx:id="descriptionArea" prefRowCount="4" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            </GridPane>

            <HBox spacing="12.0">
                <Button onAction="#handleChoosePdf" styleClass="hamburger-btn" text="Choose PDF" />
                <Label fx:id="selectedPdfLabel" text="No PDF selected" />
            </HBox>

            <HBox spacing="12.0">
                <Button fx:id="publishButton" onAction="#handlePublishAssignment" styleClass="login-button" text="Publish Assignment" />
                <Button fx:id="viewPdfButton" onAction="#handleViewSelectedPdf" styleClass="hamburger-btn" text="View Selected PDF" />
                <Button onAction="#handleRefresh" styleClass="hamburger-btn" text="Refresh" />
            </HBox>

            <Separator />

            <Label styleClass="section-header" text="Selected Assignment Progress" />
            <Label fx:id="selectedAssignmentLabel" text="No assignment selected" />
            <HBox spacing="20.0">
                <VBox>
                    <Label text="Submitted" />
                    <Label fx:id="submittedCountLabel" text="-" />
                </VBox>
                <VBox>
                    <Label text="Pending" />
                    <Label fx:id="pendingCountLabel" text="-" />
                </VBox>
            </HBox>

            <Label fx:id="statusLabel" styleClass="error-text" wrapText="true" text="" />
        </VBox>
    </HBox>

    <VBox spacing="12.0" styleClass="chart-container" VBox.vgrow="ALWAYS">
        <Label styleClass="section-header" text="Assignments Submitted by All Students" />
        <TableView fx:id="completedAssignmentsTable" prefHeight="260.0">
            <columns>
                <TableColumn fx:id="completedTitleCol" prefWidth="420.0" text="Assignment" />
                <TableColumn fx:id="completedClassCol" prefWidth="280.0" text="Class" />
                <TableColumn fx:id="completedDueDateCol" prefWidth="150.0" text="Due Date" />
                <TableColumn fx:id="completedSubmittedCol" prefWidth="150.0" text="Submissions" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox spacing="12.0">
            <Button fx:id="downloadSelectedCompletedButton" onAction="#handleDownloadSelectedCompleted" styleClass="login-button" text="Download Selected Submissions" />
            <Button fx:id="downloadAllCompletedButton" onAction="#handleDownloadAllCompleted" styleClass="hamburger-btn" text="Download All Completed Submissions" />
        </HBox>

        <Label fx:id="completedStatusLabel" styleClass="error-text" wrapText="true" text="" />
    </VBox>
</VBox>
