<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" style="-fx-background-color: #f4f7f9;" stylesheets="@../css/dashboard.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.TeacherStudentPerformanceController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="chart-container">
        <Button onAction="#backToDashboard" styleClass="hamburger-btn" text="Back to Dashboard" />
        <Separator orientation="VERTICAL" />
        <VBox spacing="6.0">
            <Label styleClass="section-header" text="Student Performance" />
            <Label fx:id="teacherInfoLabel" wrapText="true" text="Teacher: -" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <VBox alignment="CENTER_RIGHT">
            <Label text="Mapped Students" />
            <Label fx:id="studentCountLabel" text="0" />
        </VBox>
    </HBox>

    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
        <VBox spacing="12.0" prefWidth="430.0" styleClass="stat-box">
            <Label styleClass="section-header" text="Students in Your Scope" />
            <TableView fx:id="studentsTable" prefHeight="560.0">
                <columns>
                    <TableColumn fx:id="studentIdCol" prefWidth="90.0" text="Student ID" />
                    <TableColumn fx:id="nameCol" prefWidth="190.0" text="Name" />
                    <TableColumn fx:id="classCol" prefWidth="140.0" text="Class" />
                </columns>
            </TableView>
        </VBox>

        <VBox spacing="16.0" HBox.hgrow="ALWAYS" styleClass="stat-box">
            <Label styleClass="section-header" text="Academic and Conduct Summary" />

            <GridPane hgap="16.0" vgap="12.0">
                <Label text="Student" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Label fx:id="studentNameLabel" text="No student selected" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Class" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Label fx:id="classLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Attendance" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <Label fx:id="attendanceLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Average Marks" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <Label fx:id="averageMarksLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Conduct" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <Label fx:id="conductLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                <Label text="Conduct Remarks" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                <Label fx:id="conductRemarksLabel" wrapText="true" text="-" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            </GridPane>

            <HBox spacing="12.0">
                <Button fx:id="downloadSelectedButton" onAction="#handleDownloadSelected" styleClass="login-button" text="Download Selected PDF" />
                <Button fx:id="downloadAllButton" onAction="#handleDownloadAll" styleClass="hamburger-btn" text="Download All PDFs" />
            </HBox>

            <Label styleClass="section-header" text="Marks Overview" />
            <TableView fx:id="marksTable" prefHeight="320.0">
                <columns>
                    <TableColumn fx:id="subjectCol" prefWidth="200.0" text="Subject" />
                    <TableColumn fx:id="examCol" prefWidth="170.0" text="Exam Type" />
                    <TableColumn fx:id="marksCol" prefWidth="120.0" text="Marks" />
                </columns>
            </TableView>

            <Label fx:id="statusLabel" styleClass="error-text" wrapText="true" text="" />
        </VBox>
    </HBox>
</VBox>
