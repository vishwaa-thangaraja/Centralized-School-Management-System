<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" style="-fx-background-color: #f4f7f9;" stylesheets="@../css/dashboard.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.TeacherQuestionBankController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="chart-container">
        <Button onAction="#backToDashboard" styleClass="hamburger-btn" text="Back to Dashboard" />
        <Separator orientation="VERTICAL" />
        <VBox spacing="6.0">
            <Label styleClass="section-header" text="Question Bank" />
            <Label fx:id="teacherInfoLabel" text="Teacher: -" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <VBox alignment="CENTER_RIGHT">
            <Label text="Uploaded Papers" />
            <Label fx:id="questionCountLabel" text="0" />
        </VBox>
        <Button onAction="#handleRefresh" styleClass="hamburger-btn" text="Refresh" />
    </HBox>

    <HBox spacing="24.0">
        <VBox spacing="16.0" prefWidth="430.0" styleClass="stat-box">
            <Label styleClass="section-header" text="Upload Question Paper" />

            <GridPane hgap="14.0" vgap="12.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="100.0" prefWidth="110.0" />
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>

                <Label text="Class" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <ComboBox fx:id="classCombo" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Subject" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <ComboBox fx:id="subjectCombo" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Year" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <Label fx:id="academicYearLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Title" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextField fx:id="titleField" promptText="Question paper title" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            </GridPane>

            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Button onAction="#handleChoosePdf" styleClass="hamburger-btn" text="Choose PDF" />
                <Label fx:id="selectedPdfLabel" text="No PDF selected" wrapText="true" />
            </HBox>

            <Button onAction="#handlePublishQuestionPaper" maxWidth="Infinity" styleClass="login-button" text="Upload to Question Bank" />
            <Label fx:id="statusLabel" styleClass="error-text" wrapText="true" text="" />
        </VBox>

        <VBox spacing="12.0" HBox.hgrow="ALWAYS" styleClass="stat-box">
            <Label styleClass="section-header" text="Uploaded Papers" />
            <TableView fx:id="questionTable" prefHeight="520.0">
                <columns>
                    <TableColumn fx:id="titleCol" prefWidth="300.0" text="Title" />
                    <TableColumn fx:id="classCol" prefWidth="210.0" text="Class" />
                    <TableColumn fx:id="subjectCol" prefWidth="190.0" text="Subject" />
                    <TableColumn fx:id="yearCol" prefWidth="120.0" text="Year" />
                    <TableColumn fx:id="uploadedCol" prefWidth="160.0" text="Uploaded" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <HBox spacing="12.0">
                <Button fx:id="openSelectedButton" onAction="#handleOpenSelectedPdf" styleClass="hamburger-btn" text="Open Selected PDF" />
            </HBox>
        </VBox>
    </HBox>
</VBox>
